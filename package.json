{
  "name": "expense-tracker",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "prepare": "husky",
    "prisma:init:empty": "npx prisma migrate dev --skip-seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/lib-storage": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "@headlessui/react": "^2.2.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-dropdown-menu": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@remixicon/react": "^4.6.0",
    "@tremor/react": "^3.18.7",
    "argon2": "^0.43.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-http-backend": "^3.0.2",
    "isbot": "^4.1.0",
    "next-themes": "^0.4.4",
    "postcss": "^8.5.3",
    "qs": "^6.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.5.1",
    "remix-auth": "^4.2.0",
    "remix-auth-form": "^3.0.0",
    "remix-auth-github": "^3.0.2",
    "remix-i18next": "^6.4.1",
    "remix-toast": "^1.2.2",
    "tailwind-merge": "^3.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.4",
    "@tailwindcss/forms": "^0.5.10",
    "@types/qs": "^6.9.18",
